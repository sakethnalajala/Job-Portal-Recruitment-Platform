# ── Dependencies ──────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build output ──────────────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo

# ── Environment & secrets (never commit real credentials) ─────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ── Local database / runtime data ─────────────────────────────────────────
# `npm run db:local` persists MongoDB under server/.data
.data/
*.sqlite
*.sqlite3

# ── Logs ──────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Test coverage & reports ───────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# ── Caches & temp ─────────────────────────────────────────────────────────
.cache/
.vite/
.turbo/
.eslintcache
.stylelintcache
.parcel-cache/
tmp/
temp/
*.tmp
*.bak
*.orig
*.swp
*~

# ── Editor / IDE ──────────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.sublime-workspace

# ── OS files ──────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Deployment platform local state ───────────────────────────────────────
.vercel/
.netlify/
