# Base path for API calls. Keep it relative so the Vite proxy (dev) / Vercel rewrite (prod)
# makes the API same-origin and the refresh cookie first-party.
#
# PRODUCTION (Vercel): do NOT set VITE_API_URL in the Vercel dashboard — leave it unset (or
# exactly "/api/v1"). client/vercel.json rewrites /api/* to the Render service, which keeps
# requests same-origin (no CORS) and the refresh cookie first-party. Pointing this at the
# Render host directly makes every request cross-origin, so CORS must allow the Vercel
# domain and the refresh cookie (SameSite=Lax) is no longer sent — sessions drop on reload.
# VITE_* values are compiled into the public JS bundle, so they are never secret.
VITE_API_URL=/api/v1
# Dev only: where the Vite proxy forwards /api requests
VITE_PROXY_TARGET=http://localhost:5000
