          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me — no token",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/auth/me"
