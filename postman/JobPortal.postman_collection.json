{
  "info": {
    "name": "Job Portal API",
    "description": "REST API for the Job Portal & Recruitment Platform. Set `baseUrl` in the environment. The collection stores the access token automatically after login/register; the refresh cookie is handled by Postman's cookie jar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "candidateEmail",
      "value": "asha.verma@example.com"
    },
    {
      "key": "recruiterEmail",
      "value": "rohan@acme.example.com"
    },
    {
      "key": "password",
      "value": "Passw0rd123"
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""
    },
    {
      "key": "resumeId",
      "value": ""
    },
    {
      "key": "recruiterProfileId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "reportId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response has success flag', () => pm.expect(pm.response.json()).to.have.property('success'));",
          "const body = pm.response.json();",
          "if (body && body.success === true && body.data && body.data.accessToken) {",
          "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 healthy', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.services.database).to.eql('up'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register candidate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register/candidate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Asha Verma\",\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 or 409', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  const u = pm.response.json().data.user;",
                  "  pm.test('role is candidate', () => pm.expect(u.role).to.eql('candidate'));",
                  "  pm.test('no password leaked', () => pm.expect(u).to.not.have.property('passwordHash'));",
                  "  pm.test('refresh cookie set', () => pm.expect(pm.cookies.has('jp_refresh')).to.be.true);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register recruiter",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register/recruiter",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Rohan Mehta\",\n  \"email\": \"{{recruiterEmail}}\",\n  \"password\": \"{{password}}\",\n  \"companyName\": \"Acme Technologies\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 or 409', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) pm.test('role is recruiter', () => pm.expect(pm.response.json().data.user.role).to.eql('recruiter'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register — role escalation attempt (ignored)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register/candidate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Mallory\",\n  \"email\": \"mallory@example.com\",\n  \"password\": \"{{password}}\",\n  \"role\": \"admin\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.test('role stays candidate', () => pm.expect(pm.response.json().data.user.role).to.eql('candidate'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register — validation error",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register/candidate",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"A\",\n  \"email\": \"bad\",\n  \"password\": \"123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 VALIDATION_ERROR with details', () => {",
                  "  pm.response.to.have.status(400);",
                  "  const e = pm.response.json().error;",
                  "  pm.expect(e.code).to.eql('VALIDATION_ERROR');",
                  "  pm.expect(e.details).to.be.an('array').with.length.greaterThan(0);",
                  "  pm.expect(e).to.not.have.property('stack');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (candidate)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 with access token', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.accessToken).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login — wrong password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{candidateEmail}}\",\n  \"password\": \"WrongPass999\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 INVALID_CREDENTIALS', () => { pm.response.to.have.status(401); pm.expect(pm.response.json().error.code).to.eql('INVALID_CREDENTIALS'); });"
                ]
