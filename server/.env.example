# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
LOG_LEVEL=debug

# ─── Database (MongoDB Atlas) ─────────────────────────────────────────────────
# Atlas → Database → Connect → Drivers. Use a dedicated DB user with readWrite on one DB.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/job_portal?retryWrites=true&w=majority

# ─── Frontend origin (CORS + links in emails) ─────────────────────────────────
CLIENT_URL=http://localhost:5173
# Optional, comma-separated (e.g. Vercel preview URLs)
CORS_EXTRA_ORIGINS=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_random_string_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_string_of_at_least_32_chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Must be true in production (HTTPS). false only for local http://localhost
COOKIE_SECURE=false

# ─── File storage (Cloudinary) ────────────────────────────────────────────────
# Dashboard → API Keys. Resumes are stored as private raw assets; images as public uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=job-portal

# ─── Email ────────────────────────────────────────────────────────────────────
# console = print emails to the server log (development)
# resend  = send via Resend (production) — requires RESEND_API_KEY and a verified sender domain
EMAIL_PROVIDER=console
EMAIL_FROM="Job Portal <onboarding@resend.dev>"
RESEND_API_KEY=

# ─── Admin seed (used only by `npm run seed:admin`) ───────────────────────────
ADMIN_EMAIL=demo.admin@demo.jobportal.in
ADMIN_PASSWORD=Demo@1234
ADMIN_NAME=Demo Admin
